   subject=C=DE, O=D-Trust GmbH, CN=D-TRUST Root CA 1 2017, organizationIdentifier=NTRDE-HRB74346
              Public Key Algorithm: rsassaPss
   openssl verify -check_ss_sig: self-signature OK
{
